{
  "name": "@marmeon/http",
  "version": "0.3.0",
  "description": "HTTP for Marmeon apps: controllers, views and page props, redirects, signed URLs, encrypted cookies and the UI-free client core.",
  "keywords": [
    "marmeon",
    "http",
    "controllers",
    "spa",
    "ssr",
    "client"
  ],
  "homepage": "https://marmeon.com/docs",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/http"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./page": {
      "@marmeon/source": "./src/page.ts",
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./protocol": {
      "@marmeon/source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./client": {
      "@marmeon/source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./internal": {
      "@marmeon/source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./page": {
        "types": "./dist/page.d.ts",
        "default": "./dist/page.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo",
    "!{dist,src}/client/test-window.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/router": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "vite": "^8.3.1"
  },
  "marmeon": {
    "providers": [
      "HttpServiceProvider"
    ],
    "browser": [
      "src/client/**",
      "src/page.ts",
      "src/protocol.ts",
      "src/sensitive-fields.ts",
      "src/upload-header.ts",
      "src/live-protocol.ts",
      "src/tab-sync-protocol.ts"
    ]
  }
}
