# Loaded on top of .env when NODE_ENV=test (Vitest sets it).
APP_NAME="Blank (test)"
APP_URL=http://localhost
# A fixed key for tests only — never use it anywhere else.
APP_KEY=
SESSION_DRIVER=memory
CACHE_DRIVER=memory
DB_DATABASE=:memory:
LOG_LEVEL=silent
HASH_ARGON_MEMORY=1024
HASH_ARGON_TIME=1
MAIL_MAILER=array
