// Generated by `marmeon make:lint-config` — yours to change; --force writes it anew.
// Client code (views, layouts, the client entry) imports controllers, repositories, providers and module entries only with
// `import type`: a value import bundles server code into the browser. The marmeon() Vite plugin refuses that too (resolved
// paths, also indirect imports); this catches it in the editor.
// No file imports @marmeon/<package>/internal — the framework's own code, not API; tests included.
// Unused private class members are no warning, in any class: `readonly #event = true` (make:event) makes an event a type of its own and is never read.
{
  "ignorePatterns": ["node_modules/**", "dist/**"],
  "rules": { "typescript/no-import-type-side-effects": "error", "no-unused-private-class-members": "off", "no-restricted-imports": ["error", { "patterns": [{ "regex": "^@marmeon/[^/]+/internal(?:/|$)", "message": "`@marmeon/*/internal` is the framework's own code, not API — it can change in any release. Use the package's entry; if you need something only an internal subpath has, open an issue." }] }] },
  "overrides": [
    {
      "files": ["modules/*/views/**", "modules/*/layouts/**", "layouts/**", "bootstrap/client.*"],
      "rules": { "no-restricted-imports": ["error", { "patterns": [
        { "group": ["**/controllers/**"], "allowTypeImports": true, "message": "Client code (views, layouts, the client entry) imports server code — controllers, repositories, service providers, a module's entry (#modules/…) — only with `import type`: a value import bundles it, and everything it imports, into the browser." },
        { "regex": "(?:Repository|ServiceProvider)(?:\\.[cm]?[jt]sx?)?$", "allowTypeImports": true, "message": "Client code (views, layouts, the client entry) imports server code — controllers, repositories, service providers, a module's entry (#modules/…) — only with `import type`: a value import bundles it, and everything it imports, into the browser." },
        { "regex": "^#modules/", "allowTypeImports": true, "message": "Client code (views, layouts, the client entry) imports server code — controllers, repositories, service providers, a module's entry (#modules/…) — only with `import type`: a value import bundles it, and everything it imports, into the browser." },
        { "regex": "^@marmeon/[^/]+/internal(?:/|$)", "message": "`@marmeon/*/internal` is the framework's own code, not API — it can change in any release. Use the package's entry; if you need something only an internal subpath has, open an issue." }
      ] }] }
    }
  ]
}
