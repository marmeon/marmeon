# Copy to .env and adjust — `marmeon key:generate` copies it for you and sets APP_KEY. Real environment variables win over this file.
# This machine's environment: used when the process sets no NODE_ENV — development here, for every marmeon command.
# On a server set NODE_ENV=production in the real environment: it wins over this file. Never deploy this .env.
# NODE_ENV is development, test or production — nothing else starts. A staging server is NODE_ENV=production with APP_ENV=staging:
# https://github.com/marmeon/marmeon/blob/main/docs/deployment.md#staging
NODE_ENV=development
# The name of this environment, shown in the start line, the logs and the traces; it selects the scheduled tasks
# (.environments('staging')) and never weakens a protection. Default: local (development), testing (test), production (production).
# APP_ENV=local
APP_NAME=Blank
APP_URL=http://localhost:3000
# Generate with: marmeon key:generate
APP_KEY=
PORT=3000
# Behind a reverse proxy (production): its addresses or ranges, e.g. 127.0.0.1 or 10.0.0.0/8 — then X-Forwarded-* count
# TRUSTED_PROXIES=
# Cookies get Secure when APP_URL is https:// — SESSION_SECURE_COOKIE=true/false decides it yourself
# Behind a load balancer that learns from /up/ready: seconds of requests after SIGTERM before the drain
# SHUTDOWN_DELAY=5
# Database: sqlite (default, storage/database.sqlite) | pgsql (DB_URL=postgres://user:secret@localhost:5432/app)
# DB_CONNECTION=sqlite
# DB_DATABASE=storage/database.sqlite
# Sessions and cache: file (default, storage/framework/{sessions,cache} — one machine) | database | redis | memory
# SESSION_DRIVER=file
# CACHE_DRIVER=file
# Queue: database (the jobs table of modules/system; `marmeon dev` starts a worker) | redis | sync
# QUEUE_CONNECTION=database
# Mails: log (default — writes every mail, links and tokens included, to the log; never in production) | smtp | array
# MAIL_MAILER=log
# SMTP without MAIL_SECURE=true needs STARTTLS — false only for a local server without TLS (Mailpit on 1025)
# MAIL_REQUIRE_TLS=true
# Registration and the change of address of `marmeon make:auth` are private: they never tell whether an address has an account —
# false makes them say "taken" (the boot warns outside development)
# AUTH_PRIVATE_REGISTRATION=true
# Days an account may stay without a confirmed address before auth:prune-unverified of `make:auth` deletes it — for good (never one confirmed once):
# with AUTH_PRIVATE_REGISTRATION=false they were signed in and may have used the app. Not scheduled by itself: turn the line on in
# modules/auth/schedule.ts if your app wants it. 0: the command deletes nothing
# AUTH_UNVERIFIED_DAYS=7
# LOG_LEVEL=info
