{
  "name": "@bespokecore/devtools",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "./src/client/index.ts",
    "./dist/client/index.js"
  ],
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@bespokecore/source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "DevtoolsServiceProvider"
    ],
    "browser": [
      "src/client/**"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/queue": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "@bespokecore/scheduler": "workspace:*",
    "@bespokecore/server": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bespokecore/cli": {
      "optional": true
    },
    "@bespokecore/http": {
      "optional": true
    },
    "@bespokecore/queue": {
      "optional": true
    },
    "@bespokecore/router": {
      "optional": true
    },
    "@bespokecore/scheduler": {
      "optional": true
    },
    "@bespokecore/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/log": "workspace:*",
    "@bespokecore/mail": "workspace:*",
    "@bespokecore/queue": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "@bespokecore/scheduler": "workspace:*",
    "@bespokecore/server": "workspace:*",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.1"
  }
}
