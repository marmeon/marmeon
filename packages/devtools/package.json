{
  "name": "@marmeon/devtools",
  "version": "0.1.3",
  "description": "Development tools for Marmeon apps: redacted recordings of requests, queries, jobs, mails and more, with a toolbar and pages.",
  "keywords": [
    "marmeon",
    "devtools",
    "debugging"
  ],
  "homepage": "https://marmeon.com/docs/devtools",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/devtools"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": [
    "./src/client/index.ts",
    "./dist/client/index.js"
  ],
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@marmeon/source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "DevtoolsServiceProvider"
    ],
    "browser": [
      "src/client/**"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*"
  },
  "peerDependencies": {
    "marmeon": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/queue": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/scheduler": "workspace:*",
    "@marmeon/server": "workspace:*"
  },
  "peerDependenciesMeta": {
    "marmeon": {
      "optional": true
    },
    "@marmeon/http": {
      "optional": true
    },
    "@marmeon/queue": {
      "optional": true
    },
    "@marmeon/router": {
      "optional": true
    },
    "@marmeon/scheduler": {
      "optional": true
    },
    "@marmeon/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "marmeon": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/log": "workspace:*",
    "@marmeon/mail": "workspace:*",
    "@marmeon/queue": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/scheduler": "workspace:*",
    "@marmeon/server": "workspace:*",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.1",
    "valibot": "^1.5.0"
  }
}
