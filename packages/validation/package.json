{
  "name": "@marmeon/validation",
  "version": "0.1.2",
  "description": "Validation rules for Marmeon apps, typed: Standard Schema objects with messages in the request's language, database rules that never run live, query and .env rules.",
  "keywords": [
    "marmeon",
    "validation",
    "rules",
    "standard-schema",
    "typescript"
  ],
  "homepage": "https://marmeon.com/docs/validation",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/validation"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/router": "workspace:*",
    "valibot": "^1.5.0"
  }
}
