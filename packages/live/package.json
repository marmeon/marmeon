{
  "name": "@bespokecore/live",
  "version": "0.1.0",
  "description": "Live props for BespokeCore apps: pages, islands and layers follow channels and reload when the server hints a change.",
  "keywords": [
    "bespokecore",
    "live",
    "sse",
    "realtime"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/live#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/live"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "LiveServiceProvider"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@bespokecore/notifications": "workspace:*",
    "@bespokecore/redis": "workspace:*",
    "@bespokecore/session": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bespokecore/notifications": {
      "optional": true
    },
    "@bespokecore/redis": {
      "optional": true
    },
    "@bespokecore/session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bespokecore/database": "workspace:*",
    "@bespokecore/notifications": "workspace:*",
    "@bespokecore/redis": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "@bespokecore/server": "workspace:*",
    "@bespokecore/session": "workspace:*",
    "redis": "6.2.1"
  }
}
