{
  "name": "@marmeon/live",
  "version": "0.3.0",
  "description": "Live props for Marmeon apps: pages, islands and layers follow channels and reload when the server hints a change.",
  "keywords": [
    "marmeon",
    "live",
    "sse",
    "realtime"
  ],
  "homepage": "https://marmeon.com/docs/realtime",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/live"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@marmeon/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "experimental": true,
    "providers": [
      "LiveServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*"
  },
  "peerDependencies": {
    "@marmeon/notifications": "workspace:*",
    "@marmeon/redis": "workspace:*",
    "@marmeon/session": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@marmeon/notifications": {
      "optional": true
    },
    "@marmeon/redis": {
      "optional": true
    },
    "@marmeon/session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marmeon/database": "workspace:*",
    "@marmeon/notifications": "workspace:*",
    "@marmeon/redis": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/server": "workspace:*",
    "@marmeon/session": "workspace:*"
  }
}
