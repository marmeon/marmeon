{
  "name": "@marmeon/session",
  "version": "0.1.1",
  "description": "Sessions for Marmeon apps: an injectable session, file, database, Redis and cookie stores, flash data and CSRF protection.",
  "keywords": [
    "marmeon",
    "session",
    "csrf",
    "flash"
  ],
  "homepage": "https://github.com/marmeon/marmeon/tree/main/packages/session#readme",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/session"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "SessionServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/router": "workspace:*"
  },
  "peerDependencies": {
    "@marmeon/cache": "workspace:*",
    "marmeon": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/redis": "workspace:*",
    "@marmeon/scheduler": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@marmeon/cache": {
      "optional": true
    },
    "marmeon": {
      "optional": true
    },
    "@marmeon/database": {
      "optional": true
    },
    "@marmeon/redis": {
      "optional": true
    },
    "@marmeon/scheduler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marmeon/cache": "workspace:*",
    "marmeon": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/redis": "workspace:*",
    "@marmeon/scheduler": "workspace:*",
    "@marmeon/server": "workspace:*"
  }
}
