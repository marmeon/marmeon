{
  "name": "@marmeon/auth",
  "version": "0.3.0",
  "description": "Authentication and authorization for Marmeon apps: session guard, remember-me, password hashing and resets, e-mail verification, API tokens, policies and make:auth.",
  "keywords": [
    "marmeon",
    "auth",
    "authentication",
    "authorization",
    "policies",
    "api-tokens"
  ],
  "homepage": "https://marmeon.com/docs/authentication",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/auth"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./two-factor": {
      "@marmeon/source": "./src/two-factor/index.ts",
      "types": "./dist/two-factor/index.d.ts",
      "default": "./dist/two-factor/index.js"
    },
    "./passkeys": {
      "@marmeon/source": "./src/passkeys/index.ts",
      "types": "./dist/passkeys/index.d.ts",
      "default": "./dist/passkeys/index.js"
    },
    "./testing": {
      "@marmeon/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./two-factor": {
        "types": "./dist/two-factor/index.d.ts",
        "default": "./dist/two-factor/index.js"
      },
      "./passkeys": {
        "types": "./dist/passkeys/index.d.ts",
        "default": "./dist/passkeys/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "AuthServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/session": "workspace:*",
    "@marmeon/validation": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "uqr": "0.1.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@marmeon/cache": "workspace:*",
    "@marmeon/redis": "workspace:*",
    "@marmeon/server": "workspace:*",
    "jsqr": "1.4.0",
    "marmeon": "workspace:*"
  },
  "peerDependencies": {
    "@marmeon/cache": "workspace:*",
    "marmeon": "workspace:*"
  },
  "peerDependenciesMeta": {
    "marmeon": {
      "optional": true
    }
  }
}
