{
  "name": "@bespokecore/auth",
  "version": "0.0.0",
  "description": "Authentication and authorization for BespokeCore apps: session guard, remember-me, password hashing and resets, e-mail verification, API tokens, policies and make:auth.",
  "keywords": [
    "bespokecore",
    "auth",
    "authentication",
    "authorization",
    "policies",
    "api-tokens"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/auth"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "AuthServiceProvider"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "@bespokecore/session": "workspace:*",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/server": "workspace:*"
  },
  "peerDependencies": {
    "@bespokecore/cli": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bespokecore/cli": {
      "optional": true
    }
  }
}
