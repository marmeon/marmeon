{
  "name": "@bespokecore/database",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "DatabaseServiceProvider"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "kysely": "^0.29.6",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@bespokecore/cli": "workspace:*",
    "pg": "^8.23.0"
  },
  "peerDependenciesMeta": {
    "@bespokecore/cli": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bespokecore/cli": "workspace:*",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  }
}
