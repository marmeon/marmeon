{
  "name": "@marmeon/database",
  "version": "0.1.0",
  "description": "Data access on Kysely for Marmeon apps: connections, migrations per module, generated table types, repositories and pagination.",
  "keywords": [
    "marmeon",
    "database",
    "kysely",
    "migrations",
    "sqlite",
    "postgres"
  ],
  "homepage": "https://github.com/marmeon/marmeon/tree/main/packages/database#readme",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/database"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "DatabaseServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/router": "workspace:*",
    "kysely": "^0.29.6",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "marmeon": "workspace:*",
    "pg": "^8.23.0"
  },
  "peerDependenciesMeta": {
    "marmeon": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "marmeon": "workspace:*",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "@marmeon/validation": "workspace:*"
  }
}
