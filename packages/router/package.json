{
  "name": "@marmeon/router",
  "version": "0.1.1",
  "description": "The typed router of Marmeon: invokable controllers with request definitions, route model binding, middleware, URLs and cookies.",
  "keywords": [
    "marmeon",
    "router",
    "routing",
    "middleware",
    "typescript"
  ],
  "homepage": "https://github.com/marmeon/marmeon/tree/main/packages/router#readme",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/router"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./url": {
      "@marmeon/source": "./src/url.ts",
      "types": "./dist/url.d.ts",
      "default": "./dist/url.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./url": {
        "types": "./dist/url.d.ts",
        "default": "./dist/url.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@marmeon/core": "workspace:*"
  },
  "devDependencies": {
    "valibot": "^1.5.0"
  }
}
