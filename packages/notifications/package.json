{
  "name": "@bespokecore/notifications",
  "version": "0.1.0",
  "description": "Notifications for BespokeCore apps: classes with channels (mail, database), recipients as data, delivered by the queue.",
  "keywords": [
    "bespokecore",
    "notifications",
    "mail",
    "queue"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/notifications#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/notifications"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "NotificationServiceProvider"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/i18n": "workspace:*",
    "@bespokecore/mail": "workspace:*",
    "@bespokecore/queue": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bespokecore/cli": {
      "optional": true
    },
    "@bespokecore/i18n": {
      "optional": true
    },
    "@bespokecore/mail": {
      "optional": true
    },
    "@bespokecore/queue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bespokecore/cache": "workspace:*",
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/i18n": "workspace:*",
    "@bespokecore/mail": "workspace:*",
    "@bespokecore/queue": "workspace:*"
  }
}
