{
  "name": "@marmeon/notifications",
  "version": "0.1.2",
  "description": "Notifications for Marmeon apps: classes with channels (mail, database, live), recipients as data, delivered by the queue.",
  "keywords": [
    "marmeon",
    "notifications",
    "mail",
    "queue"
  ],
  "homepage": "https://marmeon.com/docs/notifications",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/notifications"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "NotificationServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "marmeon": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/i18n": "workspace:*",
    "@marmeon/mail": "workspace:*",
    "@marmeon/queue": "workspace:*"
  },
  "peerDependenciesMeta": {
    "marmeon": {
      "optional": true
    },
    "@marmeon/i18n": {
      "optional": true
    },
    "@marmeon/mail": {
      "optional": true
    },
    "@marmeon/queue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marmeon/cache": "workspace:*",
    "marmeon": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/i18n": "workspace:*",
    "@marmeon/mail": "workspace:*",
    "@marmeon/queue": "workspace:*"
  }
}
