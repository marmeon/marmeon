{
  "name": "@bespokecore/server",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__fixtures__"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "valibot": "^1.5.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bespoke": {
    "providers": [
      "ServerServiceProvider"
    ]
  },
  "devDependencies": {
    "@bespokecore/encryption": "workspace:*",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "vite": "^8.3.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
