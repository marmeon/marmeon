{
  "name": "@marmeon/server",
  "version": "0.1.3",
  "description": "The HTTP server of Marmeon apps: the kernel on Hono, server rendering through Vite or the build, islands, health checks and graceful shutdown.",
  "keywords": [
    "marmeon",
    "server",
    "http",
    "hono",
    "ssr"
  ],
  "homepage": "https://marmeon.com/docs",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/server"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./error-page": {
      "@marmeon/source": "./src/error-page/index.ts",
      "types": "./dist/error-page/index.d.ts",
      "default": "./dist/error-page/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./error-page": {
        "types": "./dist/error-page/index.d.ts",
        "default": "./dist/error-page/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11"
  },
  "marmeon": {
    "providers": [
      "ServerServiceProvider"
    ]
  },
  "devDependencies": {
    "@marmeon/encryption": "workspace:*",
    "vite": "^8.3.1",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "vite": "^8.3.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
