{
  "name": "@bespokecore/log",
  "version": "0.1.0",
  "description": "The logger of BespokeCore apps: pino behind the framework contract, pretty in development, JSON in production.",
  "keywords": [
    "bespokecore",
    "logging",
    "pino"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/log#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/log"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "LogServiceProvider"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "valibot": "^1.5.0"
  }
}
