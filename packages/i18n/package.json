{
  "name": "@marmeon/i18n",
  "version": "1.0.0-rc.1",
  "description": "Translations for Marmeon apps: typed messages per module (TS files), an ICU subset, a translator per request and the locale middleware. UI-agnostic — `@marmeon/i18n/messages` is the browser-safe core the UI adapters build on.",
  "keywords": [
    "marmeon",
    "i18n",
    "translations",
    "localization",
    "icu"
  ],
  "homepage": "https://marmeon.com/docs/localization",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/i18n"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages": {
      "@marmeon/source": "./src/messages.ts",
      "types": "./dist/messages.d.ts",
      "default": "./dist/messages.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./messages": {
        "types": "./dist/messages.d.ts",
        "default": "./dist/messages.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "I18nServiceProvider"
    ],
    "browser": [
      "src/catalog.ts",
      "src/format.ts",
      "src/locale.ts",
      "src/loader.ts",
      "src/messages.ts"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/session": "workspace:*"
  },
  "devDependencies": {
    "@marmeon/auth": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/server": "workspace:*",
    "@marmeon/validation": "workspace:*",
    "marmeon": "workspace:*",
    "valibot": "^1.5.0"
  }
}
