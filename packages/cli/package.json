{
  "name": "marmeon",
  "version": "1.0.0-rc.1",
  "description": "The marmeon command: dev, build, start, generators, tinker and the commands of the app and its packages.",
  "keywords": [
    "marmeon",
    "cli",
    "generators",
    "scaffolding"
  ],
  "homepage": "https://marmeon.com/docs/console",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "bin": {
    "marmeon": "./bin/marmeon.js"
  },
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "@marmeon/source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./internal": {
      "@marmeon/source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./main": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "docs",
    "UPGRADING.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "CliServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/server": "workspace:*"
  }
}
