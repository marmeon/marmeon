{
  "name": "@bespokecore/cli",
  "version": "0.1.0",
  "description": "The bespoke command: dev, build, start, generators, tinker and the commands of the app and its packages.",
  "keywords": [
    "bespokecore",
    "cli",
    "generators",
    "scaffolding"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "bin": {
    "bespoke": "./bin/bespoke.js"
  },
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "@bespokecore/source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./main": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "CliServiceProvider"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "@bespokecore/server": "workspace:*"
  }
}
