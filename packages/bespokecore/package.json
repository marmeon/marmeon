{
  "name": "bespokecore",
  "version": "0.1.0",
  "description": "BespokeCore in one name: the UI-agnostic runtime packages a BespokeCore app runs on, all at exactly this version — the lockstep release as one dependency (the UI adapter is chosen by the app).",
  "keywords": [
    "bespokecore",
    "framework",
    "typescript",
    "laravel",
    "ssr",
    "meta-package"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/bespokecore#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/bespokecore"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@bespokecore/auth": "workspace:*",
    "@bespokecore/cache": "workspace:*",
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/core": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/i18n": "workspace:*",
    "@bespokecore/log": "workspace:*",
    "@bespokecore/mail": "workspace:*",
    "@bespokecore/queue": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "@bespokecore/scheduler": "workspace:*",
    "@bespokecore/server": "workspace:*",
    "@bespokecore/session": "workspace:*"
  }
}
