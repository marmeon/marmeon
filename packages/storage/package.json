{
  "name": "@marmeon/storage",
  "version": "0.1.1",
  "description": "File storage for Marmeon apps: local, S3 and memory disks behind one contract, public and private files, uploads.",
  "keywords": [
    "marmeon",
    "storage",
    "files",
    "s3",
    "uploads"
  ],
  "homepage": "https://github.com/marmeon/marmeon/tree/main/packages/storage#readme",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/storage"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "StorageServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/validation": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-presigned-post": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "marmeon": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-presigned-post": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "marmeon": {
      "optional": true
    },
    "@marmeon/database": {
      "optional": true
    },
    "@marmeon/encryption": {
      "optional": true
    },
    "@marmeon/http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-presigned-post": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "marmeon": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/server": "workspace:*"
  }
}
