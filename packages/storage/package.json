{
  "name": "@bespokecore/storage",
  "version": "0.0.0",
  "description": "File storage for BespokeCore apps: local, S3 and memory disks behind one contract, public and private files, uploads.",
  "keywords": [
    "bespokecore",
    "storage",
    "files",
    "s3",
    "uploads"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/storage#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/storage"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "StorageServiceProvider"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-presigned-post": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/http": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-presigned-post": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@bespokecore/cli": {
      "optional": true
    },
    "@bespokecore/database": {
      "optional": true
    },
    "@bespokecore/encryption": {
      "optional": true
    },
    "@bespokecore/http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-presigned-post": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/server": "workspace:*"
  }
}
