{
  "name": "@bespokecore/testing",
  "version": "0.0.0",
  "description": "Feature tests for BespokeCore apps: the real application and HTTP kernel without a server, with assertions, fakes and database helpers.",
  "keywords": [
    "bespokecore",
    "testing",
    "vitest",
    "feature-tests"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/testing"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/server": "workspace:*"
  },
  "peerDependencies": {
    "@bespokecore/auth": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/devtools": "workspace:*",
    "@bespokecore/live": "workspace:*",
    "@bespokecore/mail": "workspace:*",
    "@bespokecore/notifications": "workspace:*",
    "@bespokecore/queue": "workspace:*",
    "@bespokecore/scheduler": "workspace:*",
    "@bespokecore/session": "workspace:*",
    "@bespokecore/storage": "workspace:*",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@bespokecore/auth": {
      "optional": true
    },
    "@bespokecore/database": {
      "optional": true
    },
    "@bespokecore/devtools": {
      "optional": true
    },
    "@bespokecore/live": {
      "optional": true
    },
    "@bespokecore/mail": {
      "optional": true
    },
    "@bespokecore/notifications": {
      "optional": true
    },
    "@bespokecore/queue": {
      "optional": true
    },
    "@bespokecore/scheduler": {
      "optional": true
    },
    "@bespokecore/session": {
      "optional": true
    },
    "@bespokecore/storage": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bespokecore/auth": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/devtools": "workspace:*",
    "@bespokecore/live": "workspace:*",
    "@bespokecore/mail": "workspace:*",
    "@bespokecore/notifications": "workspace:*",
    "@bespokecore/queue": "workspace:*",
    "@bespokecore/scheduler": "workspace:*",
    "@bespokecore/session": "workspace:*",
    "@bespokecore/storage": "workspace:*"
  }
}
