{
  "name": "@marmeon/testing",
  "version": "0.2.0",
  "description": "Feature tests for Marmeon apps: the real application and HTTP kernel without a server, with assertions, fakes and database helpers.",
  "keywords": [
    "marmeon",
    "testing",
    "vitest",
    "feature-tests"
  ],
  "homepage": "https://marmeon.com/docs/testing",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/testing"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/server": "workspace:*"
  },
  "peerDependencies": {
    "@marmeon/auth": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/devtools": "workspace:*",
    "@marmeon/live": "workspace:*",
    "@marmeon/mail": "workspace:*",
    "@marmeon/notifications": "workspace:*",
    "@marmeon/queue": "workspace:*",
    "@marmeon/scheduler": "workspace:*",
    "@marmeon/session": "workspace:*",
    "@marmeon/storage": "workspace:*",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@marmeon/auth": {
      "optional": true
    },
    "@marmeon/database": {
      "optional": true
    },
    "@marmeon/devtools": {
      "optional": true
    },
    "@marmeon/live": {
      "optional": true
    },
    "@marmeon/mail": {
      "optional": true
    },
    "@marmeon/notifications": {
      "optional": true
    },
    "@marmeon/queue": {
      "optional": true
    },
    "@marmeon/scheduler": {
      "optional": true
    },
    "@marmeon/session": {
      "optional": true
    },
    "@marmeon/storage": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marmeon/auth": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/devtools": "workspace:*",
    "@marmeon/live": "workspace:*",
    "@marmeon/mail": "workspace:*",
    "@marmeon/notifications": "workspace:*",
    "@marmeon/queue": "workspace:*",
    "@marmeon/scheduler": "workspace:*",
    "@marmeon/session": "workspace:*",
    "@marmeon/storage": "workspace:*"
  }
}
