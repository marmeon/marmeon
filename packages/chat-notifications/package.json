{
  "name": "@marmeon/chat-notifications",
  "version": "1.2.0",
  "description": "Chat notifications for Marmeon apps: Slack, Discord and Teams through incoming webhooks, with retries and a fake for tests.",
  "homepage": "https://marmeon.com/docs/chat-notifications",
  "keywords": [
    "marmeon",
    "notifications",
    "slack",
    "discord",
    "teams",
    "chat",
    "webhook"
  ],
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/chat-notifications"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@marmeon/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "ChatServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/fetch": "workspace:*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@marmeon/notifications": "workspace:*",
    "@marmeon/queue": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@marmeon/notifications": {
      "optional": true
    },
    "@marmeon/queue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marmeon/database": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/notifications": "workspace:*",
    "@marmeon/queue": "workspace:*"
  }
}
