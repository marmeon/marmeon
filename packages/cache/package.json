{
  "name": "@bespokecore/cache",
  "version": "0.0.0",
  "description": "Cache, rate limits and locks for BespokeCore apps — memory, file, database and Redis stores behind one injectable contract.",
  "keywords": [
    "bespokecore",
    "cache",
    "rate-limit",
    "locks"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/cache#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/cache"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "CacheServiceProvider"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/redis": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bespokecore/cli": {
      "optional": true
    },
    "@bespokecore/database": {
      "optional": true
    },
    "@bespokecore/redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/redis": "workspace:*",
    "@bespokecore/server": "workspace:*"
  }
}
