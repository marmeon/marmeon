{
  "name": "@marmeon/cache",
  "version": "0.1.3",
  "description": "Cache, rate limits and locks for Marmeon apps — memory, file, database and Redis stores behind one injectable contract.",
  "keywords": [
    "marmeon",
    "cache",
    "rate-limit",
    "locks"
  ],
  "homepage": "https://marmeon.com/docs/cache",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/cache"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "CacheServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "@marmeon/router": "workspace:*"
  },
  "peerDependencies": {
    "marmeon": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/redis": "workspace:*"
  },
  "peerDependenciesMeta": {
    "marmeon": {
      "optional": true
    },
    "@marmeon/database": {
      "optional": true
    },
    "@marmeon/redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "marmeon": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/redis": "workspace:*",
    "@marmeon/server": "workspace:*",
    "valibot": "^1.5.0"
  }
}
