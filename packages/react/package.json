{
  "name": "@marmeon/react",
  "version": "0.4.0",
  "description": "The React adapter of Marmeon: components, hooks, layouts, error boundaries and <Head> on the UI-free client core.",
  "keywords": [
    "marmeon",
    "react",
    "ssr",
    "spa",
    "adapter"
  ],
  "homepage": "https://marmeon.com/docs",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/react"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@marmeon/source": "./src/server.tsx",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./table": {
      "@marmeon/source": "./src/table.ts",
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./table-tanstack": {
      "@marmeon/source": "./src/table-tanstack.ts",
      "types": "./dist/table-tanstack.d.ts",
      "default": "./dist/table-tanstack.js"
    },
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./table": {
        "types": "./dist/table.d.ts",
        "default": "./dist/table.js"
      },
      "./table-tanstack": {
        "types": "./dist/table-tanstack.d.ts",
        "default": "./dist/table-tanstack.js"
      },
      "./styles.css": "./styles.css"
    }
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@marmeon/http": "workspace:*"
  },
  "devDependencies": {
    "@marmeon/i18n": "workspace:*",
    "@marmeon/table": "workspace:*",
    "@tanstack/react-table": "^9.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "@marmeon/i18n": "workspace:*",
    "@marmeon/table": "workspace:*",
    "@tanstack/react-table": "^9.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@marmeon/i18n": {
      "optional": true
    },
    "@marmeon/table": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "marmeon": {
    "experimental": [
      "./table",
      "./table-tanstack"
    ],
    "browser": [
      "src/**"
    ]
  }
}
