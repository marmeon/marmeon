{
  "name": "@marmeon/core",
  "version": "1.0.0-rc.4",
  "description": "The Marmeon application kernel: service container with constructor injection, providers, modules, configuration, events and diagnostics.",
  "keywords": [
    "marmeon",
    "framework",
    "dependency-injection",
    "container",
    "application"
  ],
  "homepage": "https://marmeon.com/docs",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "@marmeon/source": "./src/register.ts",
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./environment": {
      "@marmeon/source": "./src/environment.ts",
      "types": "./dist/environment.d.ts",
      "default": "./dist/environment.js"
    },
    "./dev": {
      "@marmeon/source": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    },
    "./diagnostics": {
      "@marmeon/source": "./src/diagnostics.ts",
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./deprecation": {
      "@marmeon/source": "./src/deprecation.ts",
      "types": "./dist/deprecation.d.ts",
      "default": "./dist/deprecation.js"
    },
    "./testing": {
      "@marmeon/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./internal": {
      "@marmeon/source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./register": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "./environment": {
        "types": "./dist/environment.d.ts",
        "default": "./dist/environment.js"
      },
      "./dev": {
        "types": "./dist/dev.d.ts",
        "default": "./dist/dev.js"
      },
      "./diagnostics": {
        "types": "./dist/diagnostics.d.ts",
        "default": "./dist/diagnostics.js"
      },
      "./deprecation": {
        "types": "./dist/deprecation.d.ts",
        "default": "./dist/deprecation.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "oxc-parser": "^0.155.0"
  },
  "devDependencies": {
    "valibot": "^1.5.0"
  }
}
