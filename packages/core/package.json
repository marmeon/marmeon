{
  "name": "@bespokecore/core",
  "version": "0.1.0",
  "description": "The BespokeCore application kernel: service container with constructor injection, providers, modules, configuration, events and diagnostics.",
  "keywords": [
    "bespokecore",
    "framework",
    "dependency-injection",
    "container",
    "application"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "@bespokecore/source": "./src/register.ts",
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./environment": {
      "@bespokecore/source": "./src/environment.ts",
      "types": "./dist/environment.d.ts",
      "default": "./dist/environment.js"
    },
    "./vite": {
      "@bespokecore/source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./diagnostics": {
      "@bespokecore/source": "./src/diagnostics.ts",
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./register": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "./environment": {
        "types": "./dist/environment.d.ts",
        "default": "./dist/environment.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./diagnostics": {
        "types": "./dist/diagnostics.d.ts",
        "default": "./dist/diagnostics.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "oxc-parser": "^0.152.0"
  },
  "devDependencies": {
    "valibot": "^1.5.0"
  }
}
