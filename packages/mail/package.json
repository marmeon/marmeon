{
  "name": "@marmeon/mail",
  "version": "1.0.0-rc.4",
  "description": "Mails as classes for Marmeon apps: envelopes, MJML or HTML content, transports behind a neutral message, queued sending.",
  "keywords": [
    "marmeon",
    "mail",
    "email",
    "mjml",
    "smtp"
  ],
  "homepage": "https://marmeon.com/docs/mail",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/mail"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@marmeon/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "MailServiceProvider"
    ]
  },
  "dependencies": {
    "@marmeon/core": "workspace:*",
    "nodemailer": "^10.2.1",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "mjml": "^5.4.1",
    "@marmeon/queue": "workspace:*",
    "@marmeon/router": "workspace:*"
  },
  "peerDependenciesMeta": {
    "mjml": {
      "optional": true
    },
    "@marmeon/queue": {
      "optional": true
    },
    "@marmeon/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "mjml": "^5.4.1",
    "@marmeon/queue": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/encryption": "workspace:*"
  }
}
