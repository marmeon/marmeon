{
  "name": "@bespokecore/mail",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "MailServiceProvider"
    ]
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "mjml": ">=5",
    "nodemailer": ">=10"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    },
    "mjml": {
      "optional": true
    }
  },
  "devDependencies": {
    "mjml": "^5.4.1",
    "nodemailer": "^10.0.13"
  }
}
