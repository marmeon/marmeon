{
  "name": "@bespokecore/table",
  "version": "0.1.0",
  "description": "Server-driven tables for BespokeCore apps: typed columns, policies, sorting and filters by allowlist, row and bulk actions, CSV export.",
  "keywords": [
    "bespokecore",
    "table",
    "datatable",
    "pagination",
    "csv"
  ],
  "homepage": "https://github.com/bespokecore/bespokecore/tree/main/packages/table#readme",
  "bugs": {
    "url": "https://github.com/bespokecore/bespokecore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bespokecore/bespokecore.git",
    "directory": "packages/table"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bespokecore/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@bespokecore/source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bespoke": {
    "providers": [
      "TableServiceProvider"
    ],
    "browser": [
      "src/client/**"
    ]
  },
  "dependencies": {
    "@bespokecore/auth": "workspace:*",
    "@bespokecore/core": "workspace:*",
    "@bespokecore/database": "workspace:*",
    "@bespokecore/encryption": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "kysely": "^0.29.6",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@bespokecore/server": "workspace:*"
  }
}
