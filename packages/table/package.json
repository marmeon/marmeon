{
  "name": "@marmeon/table",
  "version": "0.4.0",
  "description": "Server-driven tables for Marmeon apps: typed columns, policies, sorting and filters by allowlist, row and bulk actions, CSV export.",
  "keywords": [
    "marmeon",
    "table",
    "datatable",
    "pagination",
    "csv"
  ],
  "homepage": "https://marmeon.com/docs/tables",
  "bugs": {
    "url": "https://github.com/marmeon/marmeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmeon/marmeon.git",
    "directory": "packages/table"
  },
  "engines": {
    "node": ">=26.10"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@marmeon/source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!{dist,src}/**/*.test.*",
    "!{dist,src}/**/*.type-test.*",
    "!{dist,src}/**/__fixtures__/**",
    "!{dist,src}/**/test-helpers/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "marmeon": {
    "providers": [
      "TableServiceProvider"
    ],
    "browser": [
      "src/client/**"
    ]
  },
  "dependencies": {
    "@marmeon/auth": "workspace:*",
    "@marmeon/core": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/encryption": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/validation": "workspace:*",
    "kysely": "0.29.6",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@marmeon/server": "workspace:*",
    "happy-dom": "^20.14.5"
  }
}
