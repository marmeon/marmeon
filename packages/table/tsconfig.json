{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": [
      "ES2025",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Disposable",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise",
      "ESNext.Temporal",
      "ESNext.TypedArrays",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../router"
    },
    {
      "path": "../http"
    },
    {
      "path": "../database"
    },
    {
      "path": "../auth"
    },
    {
      "path": "../encryption"
    },
    {
      "path": "../server"
    }
  ]
}
