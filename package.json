{
  "name": "bespokecore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=26.10"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "dev": "pnpm --filter @bespokecore/web-app dev",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
