{
  "name": "bespokecore-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26.10"
  },
  "scripts": {
    "build": "bespoke package:build packages/*",
    "typecheck": "bespoke package:build packages/* && pnpm -r --parallel typecheck && tsc -p scripts",
    "test": "NODE_OPTIONS=--conditions=@bespokecore/source vitest run --configLoader native",
    "dev": "pnpm --filter @bespokecore/web-app dev",
    "docs:dev": "node scripts/docs.ts dev",
    "docs:check": "node scripts/docs.ts check",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "test:pgsql": "BESPOKE_TEST_PGSQL_URL=postgres://bespoke:secret@localhost:55432/bespoke DB_CONNECTION=pgsql DB_URL=postgres://bespoke:secret@localhost:55432/bespoke pnpm test",
    "test:redis": "BESPOKE_TEST_REDIS_URL=redis://127.0.0.1:56379 pnpm test",
    "size": "node packages/react/src/__fixtures__/size-report.ts",
    "test:s3": "BESPOKE_TEST_S3_ENDPOINT=http://127.0.0.1:56333 pnpm test packages/storage",
    "types:check": "export NODE_ENV=test && cd apps/web-app && bespoke route:types --check && bespoke db:types --check && cd ../blank-app && bespoke route:types --check && bespoke db:types --check && cd ../docs && bespoke route:types --check",
    "lint": "oxlint --deny-warnings",
    "license:sync": "node scripts/sync-license.ts",
    "template:sync": "node scripts/sync-template.ts",
    "pack:check": "node scripts/pack-check.ts",
    "pack:smoke": "node scripts/pack-smoke.ts",
    "image:smoke": "node scripts/image-smoke.ts",
    "docs:image": "node scripts/docs-image.ts",
    "bench": "node scripts/bench/index.ts",
    "gegen": "node scripts/gegen/run.ts",
    "check-changesets": "node scripts/check-changesets.ts",
    "release:version": "changeset version",
    "release:stage": "pnpm stage publish -r --provenance --access public",
    "ci": "node scripts/ci.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@bespokecore/cli": "workspace:*",
    "@bespokecore/core": "workspace:*",
    "@bespokecore/vite": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.3",
    "oxlint": "^1.86.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
