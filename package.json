{
  "name": "marmeon-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26.10"
  },
  "scripts": {
    "build": "marmeon package:build packages/*",
    "typecheck": "marmeon package:build packages/* && pnpm -r --parallel typecheck && tsc -p scripts",
    "test": "NODE_OPTIONS=--conditions=@marmeon/source vitest run --configLoader native",
    "dev": "pnpm --filter @marmeon/web-app dev",
    "website:dev": "node scripts/website.ts dev",
    "website:check": "node scripts/website.ts check",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "test:pgsql": "MARMEON_TEST_PGSQL_URL=postgres://marmeon:secret@localhost:55432/marmeon DB_CONNECTION=pgsql DB_URL=postgres://marmeon:secret@localhost:55432/marmeon pnpm test --project '*pgsql*'",
    "test:redis": "MARMEON_TEST_REDIS_URL=redis://127.0.0.1:56379 pnpm test --project '*redis*'",
    "size": "node packages/react/src/__fixtures__/size-report.ts",
    "test:s3": "MARMEON_TEST_S3_ENDPOINT=http://127.0.0.1:56333 pnpm test --project '*s3*'",
    "types:check": "export NODE_ENV=test && cd apps/web-app && marmeon route:types --check && marmeon db:types --check && cd ../blank-app && marmeon route:types --check && marmeon db:types --check && cd ../website && marmeon route:types --check",
    "lint": "oxlint --deny-warnings",
    "check:source": "node scripts/check-source.ts",
    "license:sync": "node scripts/sync-license.ts",
    "template:sync": "node scripts/sync-template.ts",
    "pack:check": "node scripts/pack-check.ts",
    "pack:smoke": "node scripts/pack-smoke.ts",
    "image:smoke": "node scripts/image-smoke.ts",
    "website:image": "node scripts/website-image.ts",
    "bench": "node scripts/bench/index.ts",
    "csp:probe": "node scripts/csp-probe.ts",
    "release:prepare": "node scripts/release-prepare.ts",
    "release:verify": "node scripts/release-verify.ts",
    "api:check": "node scripts/api.ts",
    "api:update": "marmeon package:build packages/* --clean && node scripts/api.ts --write",
    "check-release": "node scripts/check-release.ts",
    "ci": "node scripts/ci.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "marmeon": "workspace:*",
    "@marmeon/core": "workspace:*",
    "@marmeon/vite": "workspace:*",
    "@types/node": "^26.6.3",
    "oxlint": "^1.86.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
