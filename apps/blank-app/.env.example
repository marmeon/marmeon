# Copy to .env and adjust — `bespoke key:generate` copies it for you and sets APP_KEY. Real environment variables win over this file.
# This machine's environment (E170): used when the process sets no NODE_ENV — development here, for every bespoke command.
# On a server set NODE_ENV (production, staging) in the real environment: it wins over this file. Never deploy this .env.
NODE_ENV=development
APP_NAME=Blank
APP_URL=http://localhost:3000
# Generate with: bespoke key:generate
APP_KEY=
PORT=3000
# Behind a reverse proxy (production): its addresses or ranges, e.g. 127.0.0.1 or 10.0.0.0/8 — then X-Forwarded-* count (E162)
# TRUSTED_PROXIES=
# Cookies get Secure when APP_URL is https:// (E162) — SESSION_SECURE_COOKIE=true/false decides it yourself
# Behind a load balancer that learns from /up/ready: seconds of requests after SIGTERM before the drain (E163)
# SHUTDOWN_DELAY=5
# Database: sqlite (default, storage/database.sqlite) | pgsql (DB_URL=postgres://user:secret@localhost:5432/app)
# DB_CONNECTION=sqlite
# DB_DATABASE=storage/database.sqlite
# Sessions and cache: file (default, storage/framework/{sessions,cache} — one machine) | database | redis | memory
# SESSION_DRIVER=file
# CACHE_DRIVER=file
# Queue: database (the jobs table of modules/system; `bespoke dev` starts a worker) | redis | sync
# QUEUE_CONNECTION=database
# Mails: log (default — writes every mail, links and tokens included, to the log; never in production) | smtp | array
# MAIL_MAILER=log
# SMTP without MAIL_SECURE=true needs STARTTLS — false only for a local server without TLS (Mailpit on 1025)
# MAIL_REQUIRE_TLS=true
# Registration and the change of address of `bespoke make:auth` are private: they never tell whether an address has an account —
# false makes them say "taken" (like Laravel's starter kits; the boot warns outside development)
# AUTH_PRIVATE_REGISTRATION=true
# LOG_LEVEL=info
