# Copy to .env and adjust — `bespoke key:generate` copies it for you and sets APP_KEY. Real environment variables win over this file.
# This machine's environment (E170): used when the process sets no NODE_ENV — development here, for every bespoke command.
# On a server set NODE_ENV (production, staging) in the real environment: it wins over this file. Never deploy this .env.
NODE_ENV=development
APP_NAME=Blank
APP_URL=http://localhost:3000
# Generate with: bespoke key:generate
APP_KEY=
PORT=3000
# Database: sqlite (default, storage/database.sqlite) | pgsql (DB_URL=postgres://user:secret@localhost:5432/app)
# DB_CONNECTION=sqlite
# DB_DATABASE=storage/database.sqlite
# Sessions and cache: file (default, storage/framework/{sessions,cache} — one machine) | database | redis | memory
# SESSION_DRIVER=file
# CACHE_DRIVER=file
# Queue: database (the jobs table of modules/system; `bespoke dev` starts a worker) | redis | sync
# QUEUE_CONNECTION=database
# Mails: log (default — writes every mail, links and tokens included, to the log; never in production) | smtp | array
# MAIL_MAILER=log
# LOG_LEVEL=info
