{
  "name": "@marmeon/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Marmeon website: its documentation — its pages under docs/ as a normal Marmeon app, no static export. Not published; deployed as an image (apps/website/Dockerfile).",
  "imports": {
    "#modules/*": "./modules/*/index.ts"
  },
  "files": [
    "bootstrap",
    "config",
    "content",
    "layouts",
    "modules",
    "styles",
    "docs.config.ts",
    "index.html",
    "!**/*.test.ts",
    "!**/*.type-test.ts",
    "!**/*.test-support.ts"
  ],
  "scripts": {
    "dev": "marmeon dev",
    "build": "marmeon build",
    "start": "marmeon start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@marmeon/cache": "workspace:*",
    "marmeon": "workspace:*",
    "@marmeon/core": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/log": "workspace:*",
    "@marmeon/react": "workspace:*",
    "@marmeon/router": "workspace:*",
    "@marmeon/server": "workspace:*",
    "@marmeon/validation": "workspace:*",
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@marmeon/devtools": "workspace:*",
    "@marmeon/testing": "workspace:*",
    "@marmeon/vite": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
