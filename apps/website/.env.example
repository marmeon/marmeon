# Copy to .env (pnpm website:dev does it for you, with a fresh APP_KEY). Real environment variables win over this file.
APP_NAME="Marmeon"
APP_URL=http://localhost:3970
# Every Marmeon app has one (encryption is part of http); the docs never set a cookie. Generate with: marmeon key:generate
APP_KEY=
PORT=3970
# No NODE_ENV here: this app is deployed (pnpm website:dev sets development, pnpm website:start production). A .env NODE_ENV would
# win over marmeon start's default — on a server set it in the real environment. It is development, test or production only.
# The name of this environment in the start line, the logs and the traces (default: local, testing or production by NODE_ENV).
# APP_ENV=staging
# The repository whose docs/*.md and policies at the root (UPGRADING.md, CONTRIBUTING.md, SECURITY.md) are the pages, relative to this app.
# DOCS_SOURCE=../..
# Cache-Control: public, max-age=… for pages (seconds); in development pages are no-cache.
# DOCS_CACHE_MAX_AGE=300
# DOCS_SEARCH_PER_MINUTE=120
# The cache keeps the search's rate limit: file (default, storage/framework/cache) or memory.
# CACHE_DRIVER=file
