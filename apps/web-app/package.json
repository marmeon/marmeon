{
  "name": "@bespokecore/web-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#modules/*": "./modules/*/index.ts"
  },
  "scripts": {
    "dev": "node --conditions=@bespokecore/source --import @bespokecore/core/register --watch bootstrap/server.ts",
    "build": "vite build --outDir dist/client && vite build --ssr bootstrap/ssr.tsx --outDir dist/server",
    "start": "NODE_ENV=production node --import @bespokecore/core/register bootstrap/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bespokecore/core": "workspace:*",
    "@bespokecore/http": "workspace:*",
    "@bespokecore/react": "workspace:*",
    "@bespokecore/router": "workspace:*",
    "@bespokecore/server": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
