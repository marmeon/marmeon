# Copy to .env and adjust. Real environment variables win over this file.
# This machine's environment: used when the process sets no NODE_ENV — development here, for every marmeon command but start and build.
# On a server set NODE_ENV=production in the real environment: it wins over this file. Never deploy this .env.
# NODE_ENV is development, test or production — nothing else starts. A staging server is NODE_ENV=production with APP_ENV=staging:
# https://marmeon.com/docs/deployment#staging
NODE_ENV=development
# The name of this environment, shown in the start line, the logs and the traces; it selects the scheduled tasks
# (.environments('staging')) and never weakens a protection. Default: local (development), testing (test), production (production).
# APP_ENV=local
APP_NAME=Marmeon
APP_URL=http://localhost:3000
# Generate with: marmeon key:generate
APP_KEY=
PORT=3000
# Behind a proxy: seconds an idle keep-alive connection stays open — above the proxy's own (nginx's upstream keepalive_timeout 60 s)
# SERVER_KEEP_ALIVE_TIMEOUT_SECONDS=65
# Languages: the default, where missing texts come from, and (optional) the supported ones —
# by default every locale with language files (modules/*/lang/<locale>.ts, lang/<locale>.ts).
# APP_LOCALE=en
# APP_FALLBACK_LOCALE=en
# APP_LOCALES=en,de
# Sessions: database (this app: the sessions table of modules/system, from `marmeon make:session-table`) | redis | file (the
# framework's default, one machine) | memory
SESSION_DRIVER=database
# Which database or Redis connection the sessions use (default: default). Never the app's transactions: this app gives
# them — and the cache — a SQLite file of their own, the `system` connection (config/database.ts). With DB_DRIVER=pgsql
# remove this line: the sessions then open a small pool of their own to the app's database by themselves.
SESSION_CONNECTION=system
# SESSION_LIFETIME_MINUTES=120
# Encrypt the session data in its store (the payload column here) with APP_KEY — off by default; this app turns it on.
# The store's keys are hashes of the session ids either way. Switching it signs everybody out once.
SESSION_ENCRYPT=true
# Expired sessions are removed now and then after a response (default 2/100) — not in this app: its scheduler runs
# `marmeon session:prune` (modules/system/schedule.ts), and then requests draw no lottery
# SESSION_LOTTERY=2/100
# Cookies only over HTTPS (`Secure`): unset, it follows APP_URL — https://… on, http://… off; true/false (or 1/0) decide themselves
# SESSION_SECURE_COOKIE=

# Cache, rate limits (login throttle, live validation) and locks — atomic in every store:
# database (this app: the cache and cache_locks tables of modules/system, from `marmeon make:cache-table`) | redis | file | memory
CACHE_DRIVER=database
# Which database or Redis connection the cache uses (default: default) — like the sessions: the `system` SQLite file, so rate
# limits and locks work inside transactions and survive their rollback. With DB_DRIVER=pgsql remove this line.
CACHE_CONNECTION=system

# Queue (jobs like the welcome mail; the auth mails go to the `mail` queue — a worker without --queue takes every queue): database (this app: the jobs/failed_jobs tables of modules/system, from
# `marmeon make:queue-table`; `marmeon dev` starts a worker on every queue, in production run `marmeon queue:work` under a supervisor) |
# redis (lists in Redis — REDIS_URL below; failed jobs still go to failed_jobs) | sync (runs each job when it is dispatched — scripts, debugging)
QUEUE_DRIVER=database
# QUEUE_DRIVER=redis
# The database connection of the jobs table, the default queue, and the seconds before a claimed job whose worker died runs
# again — longer than any job's timeout plus the worker's --stop-timeout (queue:work refuses to start otherwise)
# QUEUE_DATABASE_CONNECTION=default
# QUEUE_DATABASE_QUEUE=default
# QUEUE_DATABASE_RETRY_AFTER_SECONDS=90
# The same for QUEUE_DRIVER=redis: the Redis connection (default: REDIS_URL), the default queue, the seconds of a claim
# QUEUE_REDIS_CONNECTION=default
# QUEUE_REDIS_QUEUE=default
# QUEUE_REDIS_RETRY_AFTER_SECONDS=90
# Failed jobs: database (failed_jobs — marmeon queue:failed / queue:retry) | null (only logged)
# QUEUE_FAILED_DRIVER=database
# Unique jobs, withoutOverlapping and job.once keep their locks and markers in the cache above (CACHE_DRIVER) — with workers on
# several machines a shared one: database or redis.

# Scheduler (modules/*/schedule.ts): `marmeon dev` starts `marmeon schedule:work`; in production run it under a supervisor
# (one per server — tasks with onOneServer() then run once, which needs the shared cache above: database or redis, never
# file or memory) or call `marmeon schedule:run` from cron every minute. `marmeon schedule:list` shows the tasks.
# Whose clocks the tasks' times are on, unless a task says .timeZone(…) (default UTC):
# SCHEDULE_TIMEZONE=Europe/Berlin

# Notifications (the bell, `/notifications`): their rows go to the notifications table of modules/system (from
# `marmeon make:notifications-table`) on this database connection — the app's own data, it joins the app's transactions
# NOTIFICATIONS_CONNECTION=default
# Their jobs and mails run on the queue above (the "new sign-in" notice on `mail`); `marmeon notifications:prune` runs nightly.

# Files (config/storage.ts): `local` (private: storage/app/private — files leave only through signed URLs that expire, e.g.
# "Download my data") and `public` (storage/app/public, served under /storage: raster images inline, everything else as a
# download). An S3 disk — AWS or an S3-compatible store — needs the AWS SDK (pnpm add @aws-sdk/client-s3
# @aws-sdk/s3-request-presigner) and these; without them the `s3` disk fails when it is first used. `docker compose up -d`
# in the repo starts one on 56333 (SeaweedFS; its test identity: marmeon / marmeon-secret, create the bucket first).
# S3_BUCKET=marmeon
# S3_REGION=eu-central-1
# S3-compatible stores only — their endpoint (the bucket then goes into the path):
# S3_ENDPOINT=http://127.0.0.1:56333
# Without these the SDK's own chain is used (AWS_* variables, an instance role, …):
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Uploads (the avatar in the profile's edit layer): the browser sends a file ahead to the private `uploads` disk (storage/app/uploads),
# the form only a token; on submit the file is checked (size, type by its bytes) and moved where it belongs. Their table
# (temporary_uploads of modules/system, from `marmeon make:uploads-table`) is infrastructure like the cache and sessions:
# the `system` file here — with DB_DRIVER=pgsql remove this line. `marmeon uploads:prune` clears expired uploads and those older than a day.
UPLOADS_CONNECTION=system
# The disk they wait on (private, never the public one), how long a token works and how long the browser has to send the file (minutes)
# UPLOADS_DISK=uploads
# UPLOADS_LIFETIME_MINUTES=120
# UPLOADS_SEND_WITHIN_MINUTES=15
# What may wait unsent: open uploads per session, megabytes announced per session, and over all sessions (0 = no limit); past one, a target is a 429
# UPLOADS_MAX_OPEN=20
# UPLOADS_MAX_OPEN_MB=1024
# UPLOADS_MAX_OPEN_TOTAL_MB=10240

# Live props: a page, an island or the bell follows a channel; a change hints every open tab (a Server-Sent-Events stream per
# tab, GET /_marmeon/live) and they reload what changed. redis: every process hears every hint — this app needs it, since the bell's
# hints come from the queue worker (the notification's `live` channel) | memory: one process only (hints from a worker reach no tab)
LIVE_DRIVER=redis
# LIVE_CONNECTION=default
# Seconds between heartbeats on an idle stream (keep it under every proxy's idle timeout), the browser's reconnect delay (ms),
# streams per process and channels per stream. Development runs HTTP/1.1: a hidden tab closes its stream (six connections per
# host) and catches up when it comes back; behind an HTTP/2 proxy every tab stays connected.
# LIVE_HEARTBEAT_SECONDS=20
# LIVE_RETRY_MILLISECONDS=3000
# LIVE_MAX_STREAMS=1000
# LIVE_MAX_STREAM_SECONDS=900
# LIVE_MAX_CHANNELS=20
# Streams of one session per process (its tabs): the 17th tab gets 429 and tries again later — so one user (or a script
# with their cookie) cannot take every stream of the process. marmeon start --workers=N needs LIVE_DRIVER=redis (memory fails the start).
LIVE_MAX_STREAMS_PER_SESSION=16

# Redis (@marmeon/redis — it brings the client): for LIVE_DRIVER=redis, CACHE_DRIVER=redis, SESSION_DRIVER=redis and QUEUE_DRIVER=redis; `docker compose up -d` in the repo starts one on 56379
REDIS_URL=redis://127.0.0.1:56379
# Prepended to every key — apps sharing one Redis stay apart. Without it the prefix is APP_NAME as a slug, plus ":"
# REDIS_PREFIX=marmeon:

# Password hashing: argon2id (default) | scrypt — hashes of both are verified either way.
# HASH_DRIVER=argon2id
# Costs (defaults: OWASP) — HASH_ARGON_MEMORY_KB (KiB) / HASH_ARGON_TIME / HASH_ARGON_PARALLELISM,
# HASH_SCRYPT_COST (log2 N) / HASH_SCRYPT_BLOCK_SIZE / HASH_SCRYPT_PARALLELISM

# The longest a sign-in lasts, in hours (1 to 720), however active the user is; a valid "Keep me signed in" cookie signs in again
# AUTH_SESSION_MAX_HOURS=24
# "Keep me signed in": days from the sign-in, at most 30, 0 turns it off (no cookie signs in; auth:prune-tokens deletes older tokens); the cookie name;
# password confirmation ("sudo mode") in seconds
# AUTH_REMEMBER_DAYS=30
# AUTH_REMEMBER_COOKIE=marmeon_remember
# AUTH_PASSWORD_TIMEOUT_SECONDS=900
# Password sign-ins a minute for one e-mail from one client (1 to 60); a day for one account from all clients (10 to 100000);
# days a browser's device cookie lasts, with which the owner signs in past a full daily limit (0 to 365, 0 turns it off)
# AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
# AUTH_ACCOUNT_SIGN_INS_PER_DAY=100
# AUTH_DEVICE_COOKIE_DAYS=90
# Registration and the change of address are private: they never tell whether an address has an account — false makes them
# say "taken" (the boot warns outside development)
# AUTH_PRIVATE_REGISTRATION=true
# Accounts that never confirm an address within this many days of their sign-up are deleted at 03:20 (auth:prune-unverified — scheduled by this app,
# opt-in: modules/auth/schedule.ts) — with their avatar, data export, links and notifications, for good (never one confirmed once): with
# AUTH_PRIVATE_REGISTRATION=false they were signed in and may have used the app. 0: the command deletes nothing
# AUTH_UNVERIFIED_DAYS=7
# true: a new password and a password reset revoke every API token of the account — set it with AUTH_PRIVATE_REGISTRATION=false
# AUTH_REVOKE_TOKENS_ON_PASSWORD_CHANGE=false

# Mail: log (default — written to the log, nothing is sent) | array | smtp (nodemailer comes with @marmeon/mail)
# MAIL_DRIVER=log
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME=Marmeon
# MAIL_HOST=127.0.0.1
# MAIL_PORT=587
# MAIL_SECURE=false
# Without MAIL_SECURE: STARTTLS or no mail — false only for a local server without TLS (Mailpit on 1025)
# MAIL_REQUIRE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Reset links: minutes valid, seconds between two links to one address
# AUTH_RESET_MINUTES=60
# AUTH_RESET_THROTTLE_SECONDS=60
# API tokens look like marmeon_… — secret scanners find leaked ones by the prefix
# AUTH_TOKEN_PREFIX=marmeon_

# sqlite (default) | pgsql
DB_DRIVER=sqlite
# SQLite: the file, relative to the app root. Postgres: the database name, required unless DB_URL is set (DB_DATABASE=marmeon for the one below).
DB_DATABASE=storage/database.sqlite
# The `system` connection's SQLite file: cache, rate limits, locks and sessions (CACHE_CONNECTION/SESSION_CONNECTION=system)
# SYSTEM_DB_DATABASE=storage/system.sqlite
# Postgres: the server and the account — `docker compose up -d` in the repo starts one on 55432
# DB_HOST=127.0.0.1
# DB_PORT=55432
# DB_USERNAME=marmeon
# DB_PASSWORD=secret
# Postgres: or the whole address in one — then DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD and DB_DATABASE are not read
# DB_URL=postgres://marmeon:secret@127.0.0.1:55432/marmeon
# Postgres: connections of the app's pool, and of the small pool of the cache and sessions
# DB_POOL_MAX=10
# DB_INFRA_POOL_MAX=4
# false: another tool manages this database's tables — Marmeon neither migrates it nor reads secret columns or soft deletes from it
# DB_MANAGED=true
# Behind a load balancer or reverse proxy: its addresses or ranges (comma-separated, CIDR: 10.0.0.0/8) or * — only from these,
# X-Forwarded-For sets ctx.ip and X-Forwarded-Proto/-Host the request's URL. Unset: the headers are ignored.
# SERVER_TRUSTED_PROXIES=
# The interface the server listens on: 127.0.0.1 (default), this machine only; 0.0.0.0 in a container or for other machines
# HOST=

# Largest accepted request body, in whole MB (1,024-based)
# SERVER_MAX_BODY_MB=8

# Makes the profile's "Recent activity" slow on purpose (ms), to watch a deferred prop load after the page. Ignored outside development and tests.
# PROFILE_ACTIVITY_DELAY=1500

# Server rendering (default true). false: pages go out without markup and the browser renders them.
# SERVER_SSR_ENABLED=true
# The SSR lab under /lab (streaming, a page that fails on the server …): on with NODE_ENV=development only; true to measure a production build.
# LAB_PAGES=true
# How long the lab's slow Suspense boundary takes on the server (ms)
# LAB_DELAY=1000

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# pretty (the default with NODE_ENV=development only) | json
# LOG_FORMAT=pretty

# Health: /up (liveness) and /up/ready (readiness: database, Redis in use, cache, queue, the private disk). Another path,
# or off when a route of the app needs /up:
# SERVER_HEALTH_PATH=/up

# OpenTelemetry: spans only when the SDK is started before the app — NODE_OPTIONS='--import ./bootstrap/telemetry.ts'
# (see docs/observability.md#starting-the-sdk). The SDK reads its own variables:
# OTEL_SERVICE_NAME=web-app
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Request headers recorded on the request span (redacted by name — authorization, cookie):
# OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=accept-language
# Every request starts a trace of its own; a caller's traceparent header is only a link. true continues the caller's trace —
# only behind an edge (gateway, ingress) that sets or strips the header itself: a trusted proxy passes the client's on unchanged
# MARMEON_OTEL_TRUST_TRACEPARENT=false
# url.query records the keys of the query only (q=&page=, a part without = as [redacted]); true records its values too, masked like any text
# MARMEON_OTEL_RECORD_QUERY_VALUES=false
# OTEL_SDK_DISABLED=true
