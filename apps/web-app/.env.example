# Copy to .env and adjust. Real environment variables win over this file.
APP_NAME=BespokeCore
APP_URL=http://localhost:3000
# Generate with: bespoke key:generate
APP_KEY=
PORT=3000
# Largest accepted request body (bytes, or 512k / 8m / 1g)
# MAX_BODY_SIZE=8m

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# pretty (default outside production) | json
# LOG_FORMAT=pretty
