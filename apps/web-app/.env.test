# Loaded on top of .env when NODE_ENV=test (Vitest sets it) — like Laravel's .env.testing.
APP_NAME="BespokeCore (test)"
APP_URL=http://localhost
# A fixed key for tests only — never use it anywhere else.
APP_KEY=base64:J1THMmM0weaSNoc1xHnSWExHWTxE/5A9NwgE4YJajvY=

# Sessions in memory: fast, and gone after each test run.
SESSION_DRIVER=memory
CACHE_DRIVER=memory
# Each test app gets its own in-memory database.
DB_DATABASE=:memory:

# Keep test output clean; the kernel tests assert on log entries directly.
LOG_LEVEL=silent

# Cheap password hashing: tests check behaviour, not strength (OWASP costs everywhere else).
HASH_ARGON_MEMORY=1024
HASH_ARGON_TIME=1
