# Copy to .env (pnpm docs:dev does it for you, with a fresh APP_KEY). Real environment variables win over this file.
APP_NAME="BespokeCore docs"
APP_URL=http://localhost:3970
# Every BespokeCore app has one (encryption is part of http); the docs never set a cookie. Generate with: bespoke key:generate
APP_KEY=
PORT=3970
# The repository whose README.md and packages/*/README.md are the pages, relative to this app.
# DOCS_SOURCE=../..
# Cache-Control: public, max-age=… for pages (seconds); in development pages are no-cache.
# DOCS_CACHE_MAX_AGE=300
# DOCS_SEARCH_PER_MINUTE=120
# The cache keeps the search's rate limit: file (default, storage/framework/cache) or memory.
# CACHE_DRIVER=file
