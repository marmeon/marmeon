{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Node runs the sources as written, so emitted code should not be down-levelled either.
    "target": "ESNext",
    // ES2025 plus exactly the newer APIs Node 26.10 ships (checked one by one) — not all of ESNext,
    // which grows with every TypeScript release (and includes decorators, which V8 cannot run yet).
    // Packages that also target browsers repeat this list and add DOM.
    "lib": ["ES2025", "ESNext.Array", "ESNext.Collection", "ESNext.Disposable", "ESNext.Error", "ESNext.Iterator", "ESNext.Promise", "ESNext.Temporal", "ESNext.TypedArrays"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Resolve sibling workspace packages to their TypeScript sources (see "exports" in each package.json).
    "customConditions": ["@bespokecore/source"],

    // Keep every file runnable by Node's native type stripping.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
