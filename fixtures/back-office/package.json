{
  "name": "@fixtures/back-office",
  "version": "0.0.0",
  "private": true,
  "description": "A package with users of its own, built like a package an app installs: a back office for editors with a table, sign-in, sign-out, sign-in list, sudo mode, authenticator app, recovery codes, passkeys and rate limits of its own, a policy over a guard slot, and the choice at boot between its own users and the app's. The tests show it in the web app.",
  "type": "module",
  "exports": {
    ".": {
      "@marmeon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./area/client": {
      "@marmeon/source": "./src/area/client.tsx",
      "default": "./dist/area/client.js"
    },
    "./area/ssr": {
      "@marmeon/source": "./src/area/ssr.tsx",
      "default": "./dist/area/ssr.js"
    },
    "./views/*": {
      "@marmeon/source": "./src/views/*.tsx",
      "default": "./dist/views/*.js"
    },
    "./lang/*": {
      "@marmeon/source": "./src/lang/*.ts",
      "types": "./dist/lang/*.d.ts",
      "default": "./dist/lang/*.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./area/client": {
        "default": "./dist/area/client.js"
      },
      "./area/ssr": {
        "default": "./dist/area/ssr.js"
      },
      "./views/*": {
        "default": "./dist/views/*.js"
      },
      "./lang/*": {
        "types": "./dist/lang/*.d.ts",
        "default": "./dist/lang/*.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "stubs"
  ],
  "devDependencies": {
    "@marmeon/auth": "workspace:*",
    "@marmeon/core": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/i18n": "workspace:*",
    "@marmeon/mail": "workspace:*",
    "@marmeon/react": "workspace:*",
    "@marmeon/session": "workspace:*",
    "@marmeon/validation": "workspace:*",
    "@marmeon/vite": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "@marmeon/auth": "workspace:*",
    "@marmeon/core": "workspace:*",
    "@marmeon/database": "workspace:*",
    "@marmeon/http": "workspace:*",
    "@marmeon/i18n": "workspace:*",
    "@marmeon/mail": "workspace:*",
    "@marmeon/react": "workspace:*",
    "@marmeon/session": "workspace:*",
    "@marmeon/validation": "workspace:*",
    "react": "^19.3.0"
  },
  "marmeon": {
    "providers": [
      "BackOfficeServiceProvider"
    ],
    "namespace": "office",
    "entry": {
      "client": "./area/client",
      "ssr": "./area/ssr"
    },
    "views": "./views",
    "lang": "./lang",
    "browser": [
      "src/area/**",
      "src/views/**"
    ]
  }
}
