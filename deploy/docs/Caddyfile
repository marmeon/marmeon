# The docs behind Caddy (deploy/docs/compose.yaml). Caddy fetches the certificate for {$DOCS_DOMAIN} from Let's Encrypt (ports 80
# and 443 must reach the server, the DNS record must point at it), renews it, redirects HTTP to HTTPS and speaks HTTP/1.1, HTTP/2
# and HTTP/3. It sets X-Forwarded-For/-Proto/-Host itself (a client's own are dropped), which the docs trust from TRUSTED_PROXIES.
# Trying it locally: DOCS_DOMAIN=localhost — Caddy then signs with its own local CA instead.
{$DOCS_DOMAIN} {
	# The docs' pages carry no secret — no session, no CSRF token, no cookie — so compressing them is safe (BREACH needs a secret
	# in the page; an app's Caddyfile from `bespoke make:docker` has no `encode`). The assets come compressed already (.br/.gz).
	encode zstd gzip
	# Browsers come back over HTTPS only, for a year (this host only, no subdomains).
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy docs:3000
}
